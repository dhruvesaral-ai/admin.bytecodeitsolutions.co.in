generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Carousal {
  id               String   @id @default(cuid())
  carousalSlideIds String[] @map("carousal_slide_ids")
  position         CarousalPosition

  @@map("carousal")
}

model CarouselSlide {
  id                 String  @id @default(cuid())
  bgImgUrl           String  @map("bg_img_url")
  order              Int
  title              String
  description        String?
  btnHrefLink        String? @map("btn_href_link")
  textContainerAlign String? @map("text_container_align")
  imgUrl             String? @map("img_url")
  bannerHrefLink     String? @map("banner_href_link")

  @@map("carousel_slide")
}

model Course {
  id                   String           @id @default(cuid())
  name                 String
  shortDescription     String?          @map("description")
  longDescription      String?          @map("long_description")
  originalPrice        Decimal?         @db.Decimal(10, 2)
  discountedPrice      Decimal?         @db.Decimal(10, 2)
  rating               Float?
  technologyTags       String[]         @map("technology_tags")
  duration             String?
  status               GeneralStatus    @default(active)
  courseImgUrl         String?          @map("course_img_url")
  syllabus             String?
  courseCategorieId    String?          @map("course_categorie_id")
  isPlacementGurranted Boolean          @default(false) @map("is_placement_gurranted")
  isInSale             Boolean          @default(false) @map("is_in_sale")
  courseModuleIds      String[]         @map("course_module_ids")
  courseCategorie      CourseCategorie? @relation(fields: [courseCategorieId], references: [id])
  leads                Lead[]

  @@map("course")
}

model Lead {
  id              String              @id @default(cuid())
  firstName       String              @map("first_name")
  lastName        String?             @map("last_name")
  username        String
  utmSource       String?             @map("utm_source")
  courseId        String?             @map("course_id")
  hasBeenCalled   Boolean             @default(false) @map("has_been_called")
  nextCallDate    DateTime?           @map("next_call_date")
  status          LeadStatus          @default(hot)
  generatedSource LeadGeneratedSource @default(online) @map("generated_source")
  leadRemark      String?             @map("lead_remark")
  message         String?
  createdAt       DateTime            @default(now()) @map("createdat")
  updatedAt       DateTime            @updatedAt @map("updatedat")
  course          Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  remarks         LeadRemark[]

  @@map("leads")
}

model LeadRemark {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  remark    String
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_remarks")
}

model CourseCategorie {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  courses Course[]

  @@map("course_categorie")
}

model CourseModule {
  id          String  @id @default(cuid())
  title       String
  description String?

  @@map("course_module")
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  profileImg  String? @map("profile_img")
  companyName String? @map("company_name")

  @@map("testimonials")
}

model SuccessStory {
  id       String   @id @default(cuid())
  videoIds String[] @map("videoids")

  @@map("SuccessStories")
}

model Batch {
  id   String @id @default(cuid())
  code String

  @@map("Batch")
}

model Class {
  id            String   @id @default(cuid())
  title         String
  dateAndTime   DateTime @map("date_and_time")
  meetLink      String?  @map("meet_link")
  recordingLink String?  @map("recording_link")
  notesLink     String?  @map("notes_link")
  courseIds     String[] @map("course_ids")
  batchIds      String[] @map("batch_ids")

  @@map("class")
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  profileId     String?       @map("profileid")
  status        GeneralStatus @default(active)
  authSessionId String?       @map("auth_session_id")
  roleId        String?       @map("role_id")
  role          Role?         @relation(fields: [roleId], references: [id])

  @@map("user")
}

model Role {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  users User[]

  @@map("role")
}

enum GeneralStatus {
  active
  inactive
}

enum LeadStatus {
  hot
  medium
  cold
  converted
}

enum LeadGeneratedSource {
  online
  offline
}

enum CarousalPosition {
  homepage
  offer_banner @map("offer-banner")
  development
  programs
  training
}

model Page {
  id          String  @id @default(cuid())
  heading     String
  subheading  String
  routeName String   @unique @map("route_name")
  
  @@map("page")
}