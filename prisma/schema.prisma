generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum GeneralStatus {
  active
  inactive
}

enum LeadStatus {
  hot
  medium
  cold
  converted
}

enum LeadGeneratedSource {
  online
  offline
}

enum CarousalPosition {
  homepage
  offer_banner @map("offer-banner")
  development
  programs
  training
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  status        GeneralStatus  @default(active)
  roleId        String?        @map("role_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  role          Role?          @relation(fields: [roleId], references: [id])
  profile       Profile?
  authSession   AuthSession?
  @@map("user")
}

model AuthSession {
  id        String   @id @default(cuid())
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  userId    String   @unique @map("user_id")
  refreshToken String @unique @map("refresh_token")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  name            String
  email           String
  status          GeneralStatus @default(active)
  profileImgUrl   String?  @map("profile_img_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses       Address[]
  enrollments     Enrollment[]
  registrations   Registration[]
  payments        Payment[]
}

model Address {
  id            String   @id @default(cuid())
  addressLine   String   @map("address_line")
  pincode       String
  city          String
  state         String
  country       String
  profileId     String   @map("profile_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Role {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@map("role")
}

model Lead {
  id              String              @id @default(cuid())
  firstName       String              @map("first_name")
  lastName        String?             @map("last_name")
  username        String
  utmSource       String?             @map("utm_source")
  courseId        String?             @map("course_id")
  hasBeenCalled   Boolean             @default(false) @map("has_been_called")
  nextCallDate    DateTime?           @map("next_call_date")
  status          LeadStatus          @default(hot)
  generatedSource LeadGeneratedSource @default(online) @map("generated_source")
  leadRemark      String?             @map("lead_remark")
  message         String?
  createdAt       DateTime            @default(now()) @map("createdat")
  updatedAt       DateTime            @updatedAt @map("updatedat")
  course          Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  remarks         LeadRemark[]

  @@map("leads")
}

model LeadRemark {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  remark    String
  createdAt DateTime @default(now()) @map("createdat")
  updatedAt DateTime @updatedAt @map("updatedat")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_remarks")
}

model Registration {
  id             String    @id @default(cuid())
  courseId       String    @map("course_id")
  batchId        String?   @map("batch_id")
  profileId      String    @map("profile_id")
  registrationNo String    @unique @map("registration_no")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payments       Payment[]
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?
  @@map("registration")
}

model Enrollment {
  id           String    @id @default(cuid())
  courseId     String    @map("course_id")
  registrationId String   @unique @map("registration_id")
  enrollmentNo String    @unique @map("enrollment_no")
  batchId      String?   @map("batch_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  profileId    String    @map("profile_id")
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payments     Payment[]
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  @@map("enrollment")
}

model Payment {
  id             String        @id @default(cuid())
  enrollmentId   String?       @map("enrollment_id")
  registrationId String?       @map("registration_id")
  paymentMethod  String        @map("payment_method")
  rupees         Decimal       @db.Decimal(10, 2)
  paymentProof   String?       @map("payment_proof")
  isVerified     Boolean       @default(false) @map("is_verified")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  profileId      String        @map("profile_id")
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@map("payment")
}

model CourseCategorie {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]

  @@map("course_categorie")
}

model Course {
  id                   String           @id @default(cuid())
  name                 String
  shortDescription     String?          @map("description")
  longDescription      String?          @map("long_description")
  originalPrice        Decimal?         @db.Decimal(10, 2)
  discountedPrice      Decimal?         @db.Decimal(10, 2)
  rating               Float?
  technologyTags       String[]         @map("technology_tags")
  duration             String?
  status               GeneralStatus    @default(active)
  courseImgUrl         String?          @map("course_img_url")
  portraitImgUrl       String?          @map("portrait_img_url")
  syllabus             String?
  courseCategorieId    String?          @map("course_categorie_id")
  isPlacementGurranted Boolean          @default(false) @map("is_placement_gurranted")
  isInSale             Boolean          @default(false) @map("is_in_sale")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  courseCategorie      CourseCategorie? @relation(fields: [courseCategorieId], references: [id])
  leads                Lead[]
  registrations        Registration[]
  enrollments          Enrollment[]
  modules              CourseModule[]
  @@map("course")
}

model CourseModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  courses     Course[]

  @@map("course_module")
}

model Class {
  id            String   @id @default(cuid())
  title         String
  dateAndTime   DateTime @map("date_and_time")
  meetLink      String?  @map("meet_link")
  recordingLink String?  @map("recording_link")
  notesLink     String?  @map("notes_link")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  batches       Batch[]

  @@map("class")
}

model Batch {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  registrations Registration[]
  enrollments   Enrollment[]
  classes       Class[]

  @@map("Batch")
}

model Carousal {
  id        String           @id @default(cuid())
  position  CarousalPosition
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  slides    CarouselSlide[]

  @@map("carousal")
}

model CarouselSlide {
  id                 String    @id @default(cuid())
  carousalId         String?   @map("carousal_id")
  bgImgUrl           String    @map("bg_img_url")
  order              Int
  title              String
  description        String?
  btnHrefLink        String?   @map("btn_href_link")
  textContainerAlign String?   @map("text_container_align")
  imgUrl             String?   @map("img_url")
  bannerHrefLink     String?   @map("banner_href_link")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  carousal           Carousal? @relation(fields: [carousalId], references: [id], onDelete: Cascade)

  @@map("carousel_slide")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  profileImg  String?  @map("profile_img")
  companyName String?  @map("company_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model SuccessStory {
  id        String   @id @default(cuid())
  videoIds  String[] @map("videoids")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("SuccessStories")
}

model Page {
  id         String    @id @default(cuid())
  heading    String
  subheading String
  routeName  String    @unique @map("route_name")
  visits     Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  pageClicks PageClicks[]
  @@map("page")
}

model PageClicks {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  fieldName String   @map("field_name")
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, fieldName])
  @@map("page_clicks")
}

model Setting {
  id        String   @id @default(cuid())
  companyLightThemedLogoUrl String?
  companyDarkThemedLogoUrl String?
  companyName String?
  companyAddress String? @map("company_address")
  companyWhatsappNumber String? @map("company_whatsapp_number")
  companyPrimaryContactNumber String? @map("company_contact_number")
  companySecondaryContactNumber String? @map("company_secondary_contact_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("setting")
}

model Projects {
  id        String   @id @default(cuid())
  name      String
  shortDescription String?
  longDescription String?
  imgUrl    String?  @map("img_url")
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("projects")
}